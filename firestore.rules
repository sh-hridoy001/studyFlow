rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User account root document
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // User study data subcollection (users/{userId}/studyData/{docId})
      match /studyData/{docId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      // Any nested subcollections under user's account
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
